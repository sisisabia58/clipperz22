# Browser-facing port for the nginx gateway.
APP_PORT=43123

# modal = send transcription/encoding to Modal GPU endpoints (default).
# Falls back to local CPU if MODAL_GPU_BASE_URL is empty.
CLIPFORGE_COMPUTE=modal

# Deploy backend/modal_app.py, then paste the *.modal.run URL here.
MODAL_GPU_BASE_URL=

# Proxy auth from `modal token new` / Modal dashboard webhook keys.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

